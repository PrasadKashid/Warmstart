# Server Config
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=True

# Upstream LLM
OPENAI_API_KEY=your_openai_api_key_here

# Cache Config
SIMILARITY_THRESHOLD=0.92
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Storage Endpoints
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=warmstart_cache